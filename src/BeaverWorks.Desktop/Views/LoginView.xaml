<UserControl x:Class="BeaverWorks.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BeaverWorks.Desktop.Views"
             xmlns:vm="clr-namespace:BeaverWorks.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
             d:DesignWidth="700" d:DesignHeight="320">
    <UserControl.Resources>
        <local:NullOrEmptyStringToVisibilityConverter x:Key="NullOrEmptyStringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Image Grid.Column="1"
               Source="/Assets/login-illustration.png"
               Stretch="Uniform"
               Margin="24,0,0,0"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

        <Grid Grid.Column="0"
              MaxWidth="360"
              HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Margin="0,0,0,16">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Log in" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                            <Setter Property="Text" Value="Create account" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBox x:Name="UsernameBox"
                 Grid.Row="1"
                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8"
                 ToolTip="Username" />

        <PasswordBox x:Name="PasswordBox"
                     Grid.Row="2"
                     Margin="0,0,0,8"
                     ToolTip="Password"
                     PasswordChanged="PasswordBox_PasswordChanged" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,0,0,8"
                    Visibility="{Binding IsRegisterMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Monthly budget:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding MonthlyBudget, UpdateSourceTrigger=PropertyChanged}"
                     Width="100"
                     ToolTip="Monthly renovation money budget" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="0,0,0,8"
                    Visibility="{Binding IsRegisterMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Weekly time budget (hrs):" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding WeeklyTimeBudget, UpdateSourceTrigger=PropertyChanged}"
                     Width="100"
                     ToolTip="Weekly available renovation time, in hours" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Command="{Binding SubmitCommand}" Padding="12,4" Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="Log in" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                <Setter Property="Content" Value="Create account" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Command="{Binding ToggleModeCommand}" Padding="12,4">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="Create account" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                <Setter Property="Content" Value="Back to log in" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="6"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyStringToVisibilityConverter}}" />

        <TextBlock Grid.Row="7"
                   Text="{Binding StatusMessage}"
                   Foreground="Green"
                   TextWrapping="Wrap"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyStringToVisibilityConverter}}" />
        </Grid>
    </Grid>
</UserControl>
