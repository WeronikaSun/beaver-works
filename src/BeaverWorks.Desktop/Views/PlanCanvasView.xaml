<UserControl x:Class="BeaverWorks.Desktop.Views.PlanCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:BeaverWorks.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlanCanvasViewModel}"
             d:DesignWidth="640" d:DesignHeight="480">
    <Grid x:Name="RootGrid" Background="Black" SizeChanged="RootGrid_SizeChanged">
        <Image x:Name="PlanImage"
               Source="{Binding PlanImage}"
               Stretch="Uniform"
               MouseLeftButtonDown="PlanImage_MouseLeftButtonDown" />

        <Canvas IsHitTestVisible="False">
            <ItemsControl ItemsSource="{Binding Markers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Ellipse Width="14" Height="14"
                                 Fill="{Binding Brush}"
                                 Stroke="White"
                                 StrokeThickness="1.5"
                                 Margin="-7,-7,0,0"
                                 ToolTip="{Binding Task.Title}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </Grid>
</UserControl>
