<UserControl x:Class="BeaverWorks.Desktop.Views.ProjectPlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:BeaverWorks.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProjectPlaceholderViewModel}"
             d:DesignWidth="400" d:DesignHeight="320">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="{Binding ProjectName}" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBlock Margin="0,0,0,4">
            <Run Text="Tasks: " /><Run Text="{Binding TaskCount, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Text="{Binding FilePath}" Foreground="Gray" TextWrapping="Wrap" />
        <TextBlock Text="(Floor-plan canvas coming in a later phase.)" Foreground="Gray" Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
